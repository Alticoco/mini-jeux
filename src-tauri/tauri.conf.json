{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mini-Jeux",
  "version": "1.0.0",
  "identifier": "fr.alexis.minijeux",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      { "label": "main", "title": "Mini-Jeux", "width": 1100, "height": 780, "minWidth": 700, "minHeight": 560, "center": true }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
    "windows": { "nsis": { "languages": ["French"], "installMode": "currentUser" } }
  }
}
